[Unit]
Description=aaroneous-devtools GitHub Actions runner (%KIND%)
After=network-online.target
Wants=network-online.target

[Service]
User=devtools-%KIND%
Group=devtools-%KIND%
WorkingDirectory=/var/lib/devtools-%KIND%/runner
Environment=HOME=/var/lib/devtools-%KIND%
ExecStart=/var/lib/devtools-%KIND%/runner/run.sh
Restart=always
RestartSec=10
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min

# What the runner may touch. A job runs as this user, so these limits are the sandbox around pull-request code.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/devtools-%KIND%
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
# A runaway job must not take the machine from the seats that also work on it.
MemoryMax=70%
TasksMax=4096

[Install]
WantedBy=multi-user.target
