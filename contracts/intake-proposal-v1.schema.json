{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema_version","id","source","priority","scope","dependencies","verification","decision"],
  "properties":{
    "schema_version":{"const":1},
    "id":{"type":"string","pattern":"^[A-Za-z0-9-]+$"},
    "source":{"$ref":"#/$defs/file"},
    "priority":{"enum":["P0","P1","P2","P3"]},
    "scope":{"type":"array","minItems":1,"maxItems":16,"items":{"$ref":"#/$defs/file"}},
    "dependencies":{"type":"array","items":{"type":"string","pattern":".*\\S.*"}},
    "verification":{"type":"array","minItems":1,"maxItems":16,"items":{"type":"string","pattern":".*\\S.*"}},
    "decision":{"type":"string","pattern":".*\\S.*"}
  },
  "$defs":{"file":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\s\\\\:|]+\\.[^\\s\\\\:|]+$"}}
}
