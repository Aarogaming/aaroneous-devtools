{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundation Schedule Review v1",
  "type": "object",
  "required": ["schema_version", "artifact_kind", "queue", "program", "primary_capacity", "claimed_or_review_lanes", "ready_candidates", "recommended_claims", "findings"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_kind": { "const": "foundation.schedule-review" },
    "queue": { "type": "string" }, "program": { "type": "string" },
    "primary_capacity": { "type": "integer", "minimum": 1 },
    "claimed_or_review_lanes": { "type": "integer", "minimum": 0 },
    "ready_candidates": { "type": "array", "items": { "type": "string" } },
    "recommended_claims": { "type": "array", "items": { "type": "string" } },
    "findings": { "type": "array", "items": { "type": "string" } }
  }
}
